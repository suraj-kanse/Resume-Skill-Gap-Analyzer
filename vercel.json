{
  "version": 2,
  "outputDirectory": "staticfiles",
  "functions": {
    "resume_skill_gap/wsgi.py": {
      "runtime": "vercel-python@3.9"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "resume_skill_gap/wsgi.py"
    }
  ]
}
